+# P32a（W53 / 0799 0800）：IR R54 拦的是「夜里有人替您看着、出事有人知道」这一**承诺语义**——一期没有夜间值班与载体，任何说法都兑现不了。
+#   NIGHT_PROMISE 是字面词表，「夜里有专人看着数据，您放心睡」「睡着了也有人替您守着血糖」换个说法就漏。按语义归纳为：
+#   夜间 / 睡眠时段词 与 有人值守谓词（有人 / 专人 + 看 / 守 / 盯 / 照看）同句，或以「放心睡」做安全担保。
+#   如实告知能力边界的否定式（「夜里没有人值守」「夜间暂无人工看护」「一期无当夜干预能力」）不是承诺，同句出现否定值守即不算。
+_NIGHT_TIME = r"(夜里|夜间|半夜|深夜|晚上|整夜|通宵|夜班|睡着|睡觉|入睡|睡梦|熟睡|睡下)"
+_NIGHT_GUARD = r"(有人|专人|值班|值守|守着|看着|盯着|守护|看护|监护|照看|帮您看|替您看|替您守)"
+NIGHT_PROMISE_RE = re.compile(rf"{_NIGHT_TIME}[^。；！？\n]{{0,12}}{_NIGHT_GUARD}|{_NIGHT_GUARD}[^。；！？\n]{{0,12}}{_NIGHT_TIME}|放心(地)?(睡|入睡|睡觉)")
+NIGHT_NEG_RE = re.compile(r"(没有|没|无|暂无|暂不|不能|无法|不会|不提供|不具备)[^。；！？\n]{0,4}(人|专人|值班|值守|看护|监护|干预|守护)")
+
+
+def _night_promise_sentences(text):
+    return [s.strip() for s in sentences(text) if NIGHT_PROMISE_RE.search(s) and not NIGHT_NEG_RE.search(s)]
+
+
 @rule("R54_服务话术不得含夜间安全承诺")
