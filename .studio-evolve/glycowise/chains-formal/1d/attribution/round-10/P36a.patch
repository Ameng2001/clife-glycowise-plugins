--- a/plugins/glycowise/_fde.py
+++ b/plugins/glycowise/_fde.py
@@ -1356,10 +1356,19 @@
     return RuleResult.ok()
 
 
+# P36a（W53 / 0748 0733）：C6 要拦的是群内出现**未脱敏的原始血糖值**——是不是原始值看语境，不看有没有写单位。原式只认「数字 + mmol」，
+#   「晚饭后血糖 14.0 偏高」「您现在血糖 16.8」这类口语写法（群消息里几乎都不带单位）全部漏过。按语义归纳：
+#   ① 带 mmol 单位的数值（原口径）；② 血糖语境词（血糖 / 读数 / 测到 / 复测 / 指血 / 空腹 / 餐后 / 饭后 / 睡前）后紧跟的数值，
+#   排除时长、剂量、百分比等非血糖单位（「餐后 30 分钟」「TIR 70%」「饭后 2 小时」不算）。
+_GLU_CTX = r"(血糖|读数|测到|测得|测出|复测|指血|空腹|餐后|饭后|睡前|夜间)"
+RAW_GLUCOSE_RE = re.compile(r"\d+(\.\d+)?\s*(mmol|毫摩尔)"
+                            rf"|{_GLU_CTX}[^。；，,！？\d]{{0,6}}\d{{1,2}}(\.\d)?(?![\d.]|\s*(分钟|分|小时|个?钟头|天|周|个月|月|岁|%|％|g|克|次|步|公里|千米|片|粒|单位|mg|毫克|ml|号|点))")
+
+
 @rule("C6_群内数据最小可见范围")
 def c6(ctx):
     text = text_of(ctx)
-    raw_vals = re.findall(r"\d+\.\d\s*mmol", text)
+    raw_vals = [m.group(0) for m in RAW_GLUCOSE_RE.finditer(text)]
     if raw_vals or _drug_dose_sentences(text):
         return _fail("C6", "群内内容含未脱敏原始血糖值或药名剂量", "群内只推脱敏卡片，明细在平台内可见")
     return RuleResult.ok()
