--- a/plugins/glycowise/_fde.py
+++ b/plugins/glycowise/_fde.py
@@ -523,9 +523,21 @@
 _GLY_PERIOD = r"(餐后|饭后|空腹)"
 _GLY_DIR = r"(降|达标|不升|不涨|不冲|不往上|不飙|冲高|飙升|稳住|稳得住|控制住|管住|压住)"
 _GLY_EFFECT = rf"({_GLY_DIR[1:-1]}|正常|波动小|波动少)"
+# P29a（W52 / 0618）：同一功效主张的第三类——对血糖**波动形态**的作用声称。「血糖曲线会变平」「峰被削掉」「波动变小」说的是
+#   吃了以后血糖曲线由起伏变平缓，即「稳定血糖」的另一种说法，与「降 / 稳住」同属食品安全法 71、73 条禁止的功效声称。
+#   原式只收「波动小 / 波动少」这种静态搭配，漏了「变平 / 拉平 / 平下来 / 削峰」这类**变化谓词**。按语义归纳为「平滑化」谓词类：
+#   只收表示「由起伏变平缓」的变化谓词（变平、拉平、抹平、压平、削峰、平下来、稳下来、变小 / 减少），不收静态状态词
+#   （「血糖平稳」「曲线平」描述的是当前状态，P24a 已说明状态描述不算声称）。主语除血糖类外加「曲线 / 波动 / 峰值」——
+#   控糖话术里单说「曲线」「峰值」指的就是血糖曲线与餐后峰值；时段主语（餐后 / 饭后 / 空腹）同样配这类谓词。
+#   「变小 / 减少」只配「波动 / 起伏 / 峰值」主语（「波动变小」「峰值减小」）；配血糖或时段主语时太泛（「饭后喝的量减少」不是声称），不收。
+_GLY_SMOOTH = (r"(变平|拉平|抹平|压平|削平|摊平|平下来|平稳下来|平缓下来|平了下来|变得?平稳|变得?平缓|变稳|稳下来|变缓"
+               r"|削峰|削掉)")
+_GLY_SHRINK = r"((会|就|能)?(变|更)(小|少)|(会|就|能)?减(小|少|轻))"
 EFFICACY_RE = re.compile(r"(降|控|稳|调节|改善|逆转|治|根治|管住|压住)[^。；，,]{0,6}(血糖|糖化|胰岛|HbA1c|并发症)"
                          rf"|{_GLY_SUBJ}[^。；，,]{{0,6}}{_GLY_EFFECT}"
                          rf"|{_GLY_PERIOD}[^。；，,]{{0,6}}{_GLY_DIR}"
+                         rf"|({_GLY_SUBJ[1:-1]}|{_GLY_PERIOD[1:-1]}|曲线|波动|峰值|起伏)[^。；，,]{{0,6}}{_GLY_SMOOTH}"
+                         rf"|(曲线|波动|峰值|起伏)[^。；，,]{{0,4}}{_GLY_SHRINK}"
                          r"|见效|起效|疗效|功效|效果\s*(更好|好|明显|显著|立竿见影)"
                          r"|([0-9一二两三四五六七八九十几半]+)\s*(天|周|个月|月)[^。；，,]{0,4}(就|即可|便)?[^。；，,]{0,2}(看到|见到|看得到|见得到|有变化)"
                          r"|疗程|坚持(吃|用|服)[^。；，,]{0,8}(个月|周|天)")
