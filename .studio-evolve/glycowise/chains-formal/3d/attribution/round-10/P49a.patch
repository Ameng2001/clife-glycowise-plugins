+    text = text_of(ctx)
+    advice = bool(EXERCISE_ADVICE_RE.search(EXERCISE_NEGATED_RE.sub("", text or "")))
+    if not advice and not _recent_exercise(ctx, pid, 3):
+        return RuleResult.ok()
+    m = STATED_CURRENT_G_RE.search(text or "") if advice else None
