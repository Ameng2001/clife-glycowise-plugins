+@action("确认缓解时钟Day0")
+def act_confirm_day0(ctx):
+    """P12（W47 / 0021）：IR §5「医师另行确认，系统不得自动推断」。写 RemissionClock（主键 patient_id）：day0 取医师给定日期，
+    status 按 §2 gated_by_meds——任一降糖药在用即清零（reset），否则 running；confirmed_by = 确认人。HIL 医师 always 由动作声明决定。"""
+    pid = str(ctx.params["patient_id"])
+    raw = str(ctx.params["day0"])
+    d0 = _dt(raw)
+    day0 = d0.date().isoformat() if d0 else raw
+    meds = [m for m in meds_of(ctx, pid) if any(k in str(m) for k in DRUG_NAMES)]
+    prev = ctx.get("RemissionClock", pid) or {}
+    status = "reset" if meds else "running"
+    ctx.stage_write("RemissionClock", pid, {"patient_id": pid, "day0": day0, "status": status, "confirmed_by": ctx.actor.id,
+                                             "confirmed_at": _now(), "previous_day0": prev.get("day0"), "_staged": exec_token(ctx)})
+    ctx.set_confidence(0.9 if d0 else 0.6)
+    ctx.add_evidence(day0=day0, parsed=bool(d0), meds_in_use=meds, previous_day0=prev.get("day0"), status=status)
+    ctx.emit_effect("workitem", on="committed", template="医师确认缓解 Day0", patient_id=pid, day0=day0, status=status)
