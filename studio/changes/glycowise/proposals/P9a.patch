+def _normalize_time(s, date_hint=None):
+    """P9a：路由层常把 device_time 给成 'HH:MM'；补上今天（或 date_hint）的日期，能解析的原样返回。"""
+    s = str(s or "")
+    if _dt(s):
+        return s
+    import re as _re
+    m = _re.fullmatch(r"(\d{1,2}):(\d{2})", s.strip())
+    if m:
+        d = str(date_hint or _now())[:10]
+        return f"{d}T{int(m.group(1)):02d}:{m.group(2)}"
+    return s
+
